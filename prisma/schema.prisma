generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @unique @default(uuid())
  name                  String
  email                 String                 @unique
  contactNumber         String                 @default("")
  password              String
  role                  userRoles
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  active                Boolean                @default(true)
  paypalEmail           String?
  payouts               Payout[]
  volunteerApplications VolunteerApplication[]
  chats                 ChatMessage[]
  @@map("users")
}

model Opportunity {
  id                    String                 @id @unique @default(uuid())
  image                 String[]
  title                 String
  description           String
  location              String
  organization          String
  skillsRequired        String[]               @default([])
  duration              Int
  startDate             DateTime
  endDate               DateTime
  status                OpportunityStatus      @default(OPEN)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  benefit               String                 @default("")
  stipend               Decimal                @default(0)
  volunteerApplications VolunteerApplication[]

  @@map("opportunities")
}

model VolunteerApplication {
  id                  String            @id @unique @default(uuid())
  userId              String
  opportunityId       String
  status              ApplicationStatus @default(PENDING)
  volunteerExperience String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  payouts             Payout?
  opportunity         Opportunity       @relation(fields: [opportunityId], references: [id])
  user                User              @relation(fields: [userId], references: [id])

  @@map("volunteerApplications")
}

model Payout {
  id                     String               @id @default(uuid())
  volunteerApplicationId String               @unique()
  userId                 String
  amount                 Decimal
  currency               String               @default("USD")
  status                 PayoutStatus         @default(INITIALIZED)
  batchStatus             BatchStatus         @default(PENDING)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  transactionId          String?
  payerId                String?
  senderItemId           String?
  payoutbatchId          String?
  senderbatchId          String?
  user                   User                 @relation(fields: [userId], references: [id])
  volunteerApplication   VolunteerApplication @relation(fields: [volunteerApplicationId], references: [id])
}

  
//to save user's chat history with the bot 
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?  // null for guests
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?  // for guest sessions
  role      userType     
  content   String
  createdAt DateTime @default(now())
}

enum userRoles {
  User
  Admin
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
  INITIALIZED
  BLOCKED
}

enum BatchStatus {
  PENDING
  SUCCESS
  DENIED
  PROCESSING
}

enum userType {
  user
  bot
}